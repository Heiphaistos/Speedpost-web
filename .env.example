# Adresse publique (sous-domaine redirigé vers le VPS)
PUBLIC_URL=https://speedpost.mondomaine.fr
HOST=127.0.0.1
PORT=3080
DATA_DIR=/var/lib/speedpost

# Envoi : vide = ouvert à tous (sans compte). Mettez un mot de passe pour un serveur privé.
UPLOAD_PASSWORD=

# Limites
MAX_FILE_MB=10240
MAX_FILES=200
QUOTA_GB=200
DEFAULT_DAYS=7
MAX_DAYS=30

# E-mail FACULTATIF (sinon : lien seul, ou bouton « Par e-mail » qui ouvre la messagerie de l'expéditeur)
# SMTP_URL=smtps://utilisateur:motdepasse@smtp.fournisseur.fr:465
# MAIL_FROM=SpeedPost <no-reply@mondomaine.fr>
