[Unit]
Description=SpeedPost (transfert de fichiers chiffré)
After=network.target

[Service]
Type=simple
User=speedpost
WorkingDirectory=/opt/speedpost
EnvironmentFile=/opt/speedpost/.env
ExecStart=/usr/bin/node src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/speedpost

[Install]
WantedBy=multi-user.target
